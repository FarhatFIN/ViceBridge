get_filename_component(guest_dir "${GUEST}" DIRECTORY)
get_filename_component(guest_name "${GUEST}" NAME)
set(loader_options)
if(ATTACH_ON_ENTRY)
  list(APPEND loader_options --attach-on-entry)
endif()
foreach(mode args no_args fail_init)
  set(args)
  if(mode STREQUAL "args")
    set(args hello "two words")
    if(ATTACH_ON_ENTRY)
      list(PREPEND args same-thread)
    endif()
  elseif(mode STREQUAL "fail_init")
    set(args fail-init)
  endif()
  # This control compares against Microsoft's native UCRT startup contract.
  if(NOT RUNNER AND NOT ATTACH_ON_ENTRY AND NOT mode STREQUAL "fail_init")
    execute_process(COMMAND "${GUEST}" ${args} TIMEOUT 90
      RESULT_VARIABLE native_code OUTPUT_VARIABLE native_output ERROR_VARIABLE native_error)
    if(NOT native_code STREQUAL "0" OR NOT native_output MATCHES "tiny_startup_cmdline: PASS")
      message(FATAL_ERROR "Native startup command line (${mode}) returned ${native_code}\n${native_output}\n${native_error}")
    endif()
  endif()
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef trace_id)
  set(trace_path "${guest_dir}/startup-${trace_id}.jsonl")
  execute_process(
    COMMAND ${RUNNER} "${LOADER}" --run "${guest_name}" ${loader_options} --trace "startup-${trace_id}.jsonl" -- ${args}
    WORKING_DIRECTORY "${guest_dir}"
    TIMEOUT 90
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(READ "${trace_path}" trace)
  file(REMOVE "${trace_path}")
  string(FIND "${trace}" [=["kind":"entry"]=] entry_pos)
  string(FIND "${trace}" [=["kind":"exit"]=] exit_pos)
  if(mode STREQUAL "fail_init")
    if(NOT entry_pos EQUAL -1)
      message(FATAL_ERROR "Failed process attach recorded a guest entry")
    endif()
  elseif(entry_pos LESS 0 OR exit_pos LESS entry_pos OR NOT trace MATCHES
         [=["at":"tiny_startup_cmdline[.]exe[+]0x[0-9a-f]+","thread":[1-9][0-9]*]=])
    message(FATAL_ERROR "Missing or misordered guest entry event: ${trace}")
  endif()
  if(ATTACH_ON_ENTRY AND mode STREQUAL "args")
    string(REGEX MATCH "startup thread: EXE attach=[0-9]+, main=[0-9]+" startup_threads "${output}")
    message(STATUS "${startup_threads}")
  endif()
  if(mode STREQUAL "fail_init")
    if(NOT code STREQUAL "1" OR NOT error MATCHES "DllMain returned FALSE" OR output MATCHES "running ")
      message(FATAL_ERROR "Failed attach returned ${code}\n${output}\n${error}")
    endif()
    if(NOT output MATCHES "2 module\\(s\\) mapped, [0-9]+ unimplemented import\\(s\\)"
        OR NOT output MATCHES "unimplemented by return policy: hresult=[0-9]+ other=[0-9]+")
      message(FATAL_ERROR "Failed attach lost the import binding report\n${output}\n${error}")
    endif()
  elseif(NOT code STREQUAL "0" OR NOT output MATCHES "tiny_startup_cmdline: PASS"
      OR NOT output MATCHES "game exited with code 0")
    message(FATAL_ERROR "Startup command line (${mode}) returned ${code}\n${output}\n${error}")
  endif()
endforeach()
